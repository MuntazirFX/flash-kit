name: Build FlashKit
on: [push, workflow_dispatch]
jobs:
  build:
    runs-on: macos-latest
    steps:
    - uses: actions/checkout@v4
    
    - name: Install XcodeGen
      run: brew install xcodegen
      
    - name: Generate Xcode Project
      run: |
        echo "name: FlashKit
        options:
          bundleIdPrefix: com.muntazir
        targets:
          FlashKit:
            type: application
            platform: iOS
            deploymentTarget: \"15.0\"
            sources: [Sources]
            resources: [www]
            settings:
              GENERATE_INFOPLIST_FILE: YES
              INFOPLIST_KEY_UILaunchScreen_Generation: YES" > project.yml
        xcodegen generate
        
    - name: Build App
      run: |
        xcodebuild -project FlashKit.xcodeproj -scheme FlashKit -sdk iphoneos -configuration Release CODE_SIGNING_ALLOWED=NO -derivedDataPath build
        mkdir Payload
        cp -r build/Build/Products/Release-iphoneos/FlashKit.app Payload/
        
        # Yeh line force karegi ke www folder (Ruffle) app ke andar jaye
        cp -r www Payload/FlashKit.app/www
        
        zip -r FlashKit.ipa Payload
        
    - name: Upload IPA
      uses: actions/upload-artifact@v4
      with:
        name: FlashKit-IPA
        path: FlashKit.ipa
